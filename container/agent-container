#!/usr/bin/env bash
# agent-container — a sandboxed coding agent (Claude Code, Codex or Pi) from the published image, for
# hosts WITHOUT a devcontainer workflow. Requirements: rootless podman
# (or docker) and /dev/net/tun on the host. Copy this script onto your
# PATH, cd into a project, run `agent-container`.
#
# One NAMED container per project directory: created on first run, reused
# on later runs. gh/glab logins made inside it therefore live for the
# container's lifetime — the same container-scoped credential model as a
# devcontainer (re-authenticate after --recreate), never a host-credential
# mount. The container's own process is an idle keeper; every session is
# an exec into it, so --agent, --shell and AGENT_ARGS apply on every run.
# Only --host-net and --mount are fixed at create time (--recreate to
# change them). The container stops when its last session exits.
#
# Usage: agent-container [OPTIONS] [AGENT_ARGS...]
#   --agent NAME    which sandboxed agent to run: claude (default), codex, pi
#                   All use the same sandbox. Pi supports cloud and local models.
#                   See the use-pi guide for the localhost model relay.
#   --shell         a plain (UNSANDBOXED) bash in the container instead of an
#                   agent — e.g. to run `agent-sandbox gh-auth` first. Start a
#                   sandboxed session from it with claude / codex / pi.
#   --recreate      remove and recreate the project container (e.g. after
#                   a `podman pull`); forge auth must be re-done after
#   --host-net      create with --network=host (EPICS CA broadcast, X11)
#   --mount PATH    bind PATH read-write into the container AND the
#                   sandbox (repeatable; becomes an allow-write entry)
#   --version       print launcher version and exit
#   -h | --help     this text
#
# Environment (all optional):
#   AGENT_SANDBOX_IMAGE          image ref
#                                 (default ghcr.io/diamondlightsource/agent-sandbox:latest)
#   AGENT_SANDBOX_ENGINE         podman | docker (default podman)
#   AGENT_SANDBOX_SHARED_CONFIG  host dir mounted at /user-terminal-config to
#                                 persist Claude login/memory across containers
#                                 (default ~/.config/terminal-config)
#   AGENT_SANDBOX_CONF           host sandbox conf, mounted READ-ONLY at
#                                 /etc/agent-sandbox.conf when the file exists
#                                 (default ~/.config/agent-sandbox.conf)
#   AGENT_SANDBOX_*              any other sandbox variable is passed through
#                                 at create time (allow-ip, egress-jail, ...)
set -euo pipefail

# Bump when this script meaningfully changes. CI bakes the version into
# the image as a label, so warn_if_outdated can compare script vs image.
VERSION="0.5.0"

IMAGE="${AGENT_SANDBOX_IMAGE:-ghcr.io/diamondlightsource/agent-sandbox:latest}"
ENGINE="${AGENT_SANDBOX_ENGINE:-podman}"
SHARED="${AGENT_SANDBOX_SHARED_CONFIG:-$HOME/.config/terminal-config}"
CONF="${AGENT_SANDBOX_CONF:-$HOME/.config/agent-sandbox.conf}"

usage() {
    # The header comment above IS the manual; print it (strip the '# ').
    sed -n '2,/^set -euo pipefail$/p' "$0" | sed -e '$d' -e 's/^# \{0,1\}//'
}

# CI bakes two labels into the image: the version of this script it was
# built and tested with, and the git revision to fetch it from. Compare
# against the LOCAL image (no network, no container start) and print an
# actionable hint on mismatch. Notify only — this script runs
# unsandboxed on the host, so updating it must stay a deliberate,
# reviewable act, never something it does to itself.
warn_if_outdated() {
    local img_ver rev
    img_ver="$("$ENGINE" image inspect \
        -f '{{index .Config.Labels "io.diamondlightsource.agent-sandbox.launcher-version"}}' \
        "$IMAGE" 2>/dev/null)" || return 0
    { [ -n "$img_ver" ] && [ "$img_ver" != "$VERSION" ]; } || return 0
    if [ "$(printf '%s\n' "$VERSION" "$img_ver" | sort -V | head -1)" = "$VERSION" ]; then
        rev="$("$ENGINE" image inspect \
            -f '{{index .Config.Labels "org.opencontainers.image.revision"}}' \
            "$IMAGE" 2>/dev/null)" || rev=""
        echo "agent-container: this launcher is v$VERSION; the image was built with v$img_ver. Update:" >&2
        echo "    curl -fsSLO https://raw.githubusercontent.com/DiamondLightSource/agent-sandbox/${rev:-main}/container/agent-container" >&2
    else
        echo "agent-container: this launcher (v$VERSION) is newer than the local image (v$img_ver);" >&2
        echo "    consider: $ENGINE pull $IMAGE  then  agent-container --recreate" >&2
    fi
}

# The container's PID 1. Matched by is_keeper below to recognise a container
# this launcher model created; a container from launcher <= 0.3 baked an
# agent command instead and must be recreated.
KEEPER_CMD='trap "exit 0" TERM INT; while :; do sleep 60 & wait $!; done'

recreate=0
host_net=0
agent=claude
shell=0
create_opts=()     # create-time flags the user passed, for the reuse warning
mounts=()
while [ $# -gt 0 ]; do
    case "$1" in
        --recreate) recreate=1; shift ;;
        --host-net) host_net=1; create_opts+=( --host-net ); shift ;;
        --shell) shell=1; shift ;;
        --agent)
            # Which sandboxed agent to run in the image. All are wrapped by
            # the same shadow inside; this only chooses the command.
            case "${2:-}" in
                claude|codex|pi) agent="$2"; shift 2 ;;
                *)
                    echo "agent-container: --agent needs claude, codex, or pi" >&2
                    exit 1
                    ;;
            esac
            ;;
        --mount)
            if [ $# -lt 2 ]; then
                echo "agent-container: --mount needs a PATH" >&2
                exit 1
            fi
            mounts+=( "$(realpath "$2")" )
            create_opts+=( "--mount $2" )
            shift 2
            ;;
        --version) echo "agent-container $VERSION"; exit 0 ;;
        -h|--help) usage; exit 0 ;;
        --) shift; break ;;
        *) break ;;
    esac
done
# Remaining args are the agent's (applied on every run).

if ! command -v "$ENGINE" >/dev/null 2>&1; then
    echo "agent-container: $ENGINE not found (set AGENT_SANDBOX_ENGINE=docker?)" >&2
    exit 1
fi

# Silently a no-op until the image has been pulled / carries the labels.
warn_if_outdated

# Stable per-project container name: a readable basename slug plus a hash
# of the full path, so same-named projects under different parents don't
# collide.
slug="$(basename "$PWD" | tr -c 'a-zA-Z0-9_.-' '-')"
slug="${slug%-}"
path_hash="$(printf '%s' "$PWD" | cksum | awk '{print $1}')"
NAME="agent-sandbox-${slug}-${path_hash}"

container_exists() {
    "$ENGINE" container inspect "$NAME" >/dev/null 2>&1
}

container_running() {
    [ "$("$ENGINE" container inspect -f '{{.State.Running}}' "$NAME" 2>/dev/null)" = "true" ]
}

is_keeper() {
    "$ENGINE" container inspect -f '{{join .Config.Cmd " "}}' "$NAME" 2>/dev/null \
        | grep -qF 'sleep 60 & wait'
}

create_container() {
    mkdir -p "$SHARED"
    local -a args=(
        create --name "$NAME"
        # The egress jail (ADR 0015) is fail-closed without /dev/net/tun.
        --device /dev/net/tun
        # SELinux hosts (RHEL): don't try to relabel NFS/home mounts.
        --security-opt label=disable
        -v "$PWD:$PWD" -w "$PWD"
        -v "$SHARED:/user-terminal-config"
        -e "TERM=${TERM:-xterm-256color}"
    )
    if [ "$host_net" = 1 ]; then
        args+=( --network=host )
    fi
    # Read-only git identity (name/email) for commits inside the sandbox.
    if [ -f "$HOME/.gitconfig" ]; then
        args+=( -v "$HOME/.gitconfig:/root/.gitconfig:ro" )
    fi
    # Durable per-user sandbox conf: READ-ONLY at the canonical /etc path
    # (Invariant 4 — conf stays outside the sandbox rw set). The
    # entrypoint sees the mount and skips re-stamping the baked copy.
    if [ -f "$CONF" ]; then
        args+=( -v "$CONF:/etc/agent-sandbox.conf:ro" )
    fi
    # --mount PATH: bind into the container at the same path, and tell the
    # sandbox to bind it rw too (allow-write, joined with ':').
    local m allow_write=""
    for m in "${mounts[@]+"${mounts[@]}"}"; do
        args+=( -v "$m:$m" )
        allow_write="${allow_write:+$allow_write:}$m"
    done
    if [ -n "$allow_write" ]; then
        args+=( -e "AGENT_SANDBOX_ALLOW_WRITE=$allow_write" )
    fi

    # Pass the rest of the AGENT_SANDBOX_* env through (allow-ip,
    # egress-jail, workspace-root, no-forge, ...). Frozen at create time
    # — use --recreate (or the conf file) to change them later.
    local v
    for v in $(compgen -v AGENT_SANDBOX_ || true); do
        case "$v" in
            AGENT_SANDBOX_IMAGE|AGENT_SANDBOX_ENGINE) continue ;;
            AGENT_SANDBOX_SHARED_CONFIG|AGENT_SANDBOX_CONF) continue ;;
            AGENT_SANDBOX_ALLOW_WRITE) continue ;;
        esac
        args+=( -e "$v=${!v}" )
    done

    # The baked command is an idle keeper, not an agent: sessions are execs
    # (see the launch sequence below), so the agent and its arguments are
    # chosen per run rather than frozen here. Bash as PID 1 reaps the
    # orphans a session leaves behind; the trap lets `stop` end it promptly.
    args+=( "$IMAGE" bash -c "$KEEPER_CMD" )
    "$ENGINE" "${args[@]}" >/dev/null
    echo "agent-container: created container $NAME from $IMAGE" >&2
    echo "agent-container: for forge push access: agent-container --shell, then agent-sandbox gh-auth" >&2
}

if [ "$recreate" = 1 ] && container_exists; then
    "$ENGINE" rm -f "$NAME" >/dev/null
fi

if container_exists; then
    if ! is_keeper; then
        # Created by launcher <= 0.3, which baked the agent as PID 1; starting
        # it would run that agent detached, alongside our session.
        echo "agent-container: $NAME was created by an older launcher and cannot be reused;" >&2
        echo "  run: agent-container --recreate (forge logins must be re-done)" >&2
        exit 1
    fi
    created="$("$ENGINE" container inspect -f '{{.Created}}' "$NAME" 2>/dev/null | cut -c1-19)"
    echo "agent-container: reconnecting to existing container $NAME (created ${created:-?}); --recreate rebuilds it" >&2
    if [ ${#create_opts[@]} -gt 0 ]; then
        # Everything else applies per run; these two are baked into the
        # container and silently ignored on reuse — say so.
        echo "  create-time option(s) ignored on an existing container: ${create_opts[*]}" >&2
        echo "  use --recreate to apply them" >&2
    fi
else
    create_container
fi

if ! container_running; then
    "$ENGINE" start "$NAME" >/dev/null
    if ! container_running; then
        # The entrypoint refused (typically: this host cannot nest user
        # namespaces). Its message is in the container log.
        echo "agent-container: $NAME exited during start:" >&2
        "$ENGINE" logs "$NAME" >&2 || true
        exit 1
    fi
fi

# The session. Fresh args apply every time: this is an exec, not a replay
# of create-time arguments. A second agent-container in the same project
# while one is active simply execs another session into the same container.
if [ "$shell" = 1 ]; then
    set -- bash "$@"
else
    set -- "$agent" "$@"
fi
rc=0
"$ENGINE" exec -it "$NAME" "$@" || rc=$?

# Stop the keeper when ours was the last session, so an idle project does
# not leave a running container behind; a session still open in another
# terminal keeps it up.
if [ "$("$ENGINE" container inspect -f '{{len .ExecIDs}}' "$NAME" 2>/dev/null)" = 0 ]; then
    "$ENGINE" stop -t 2 "$NAME" >/dev/null 2>&1 || true
fi
exit "$rc"
